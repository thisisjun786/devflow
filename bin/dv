#!/usr/bin/env bash
set -euo pipefail
DV_ENTRY=${BASH_SOURCE[0]}
while [ -L "$DV_ENTRY" ]; do
  entry_dir=$(cd "$(dirname "$DV_ENTRY")" && pwd)
  DV_ENTRY=$(readlink "$DV_ENTRY")
  [[ "$DV_ENTRY" = /* ]] || DV_ENTRY="$entry_dir/$DV_ENTRY"
done
# shellcheck source=lib/common.sh
source "$(dirname "$DV_ENTRY")/../lib/common.sh"
# shellcheck source=lib/herdr.sh
source "$DV_ROOT/lib/herdr.sh"
# shellcheck source=lib/commands.sh
source "$DV_ROOT/lib/commands.sh"
# shellcheck source=lib/delivery.sh
source "$DV_ROOT/lib/delivery.sh"
# shellcheck source=lib/polish.sh
source "$DV_ROOT/lib/polish.sh"
# shellcheck source=lib/bidding.sh
source "$DV_ROOT/lib/bidding.sh"
# shellcheck source=lib/manager.sh
source "$DV_ROOT/lib/manager.sh"
# shellcheck source=lib/task.sh
source "$DV_ROOT/lib/task.sh"
# shellcheck source=lib/qa.sh
source "$DV_ROOT/lib/qa.sh"
command=${1:-help}; [ "$#" -eq 0 ] || shift
if [ "$command" = submit ] && [ "${1:-}" = --kind ]; then
  [ "$#" -ge 2 ] || fail 'missing --kind value'
  kind=$2; shift 2
  case "$kind" in task) task_submit "$@"; exit ;; code) ;; *) fail 'kind must be code or task' ;; esac
fi
case "$command" in
  help|--help|-h) printf '%s\n' 'dv submit --kind task <workspace> <ISSUE> <slug> --brief FILE [--agent codex|claude]' 'dv land <task ISSUE> --checked HEAD (after checking out/ and report.md)' ;;
  land|clean|pr|pr-wait|_pr-wait-start|review|polish)
    if task_issue "${1:-}"; then
      case "$command" in
        land) task_land "$@" ;; clean) task_clean "$@" ;;
        *) fail 'task jobs have no PR, CI or code review; inspect out/ and report.md, then dv land TASK --checked HEAD' ;;
      esac
      exit
    fi ;;
esac
case "$command" in
  manager) cmd_manager "$@" ;;
  qa) cmd_qa "$@" ;;
  _qa-run) cmd__qa_run "$@" ;;
  _manager-run) cmd__manager_run "$@" ;;
  host)
    # shellcheck source=lib/host.sh
    source "$DV_ROOT/lib/host.sh"
    cmd_host "$@" ;;
  start|done|pr|polish|review|land|status|send|clean|kick|submit|bid|queue|cancel|_submit|_award|_receipt) "cmd_$command" "$@" ;;
  pr-wait) cmd_pr_wait "$@" ;;
  _pr-wait-start) cmd_pr_wait_start "$@" ;;
  metrics) cmd_metrics "$@" ;;
  _metrics-sample) cmd__metrics_sample "$@" ;;
  _metrics-collect) cmd__metrics_collect "$@" ;;
  _agent) run_agent "$@" ;;
  help|--help|-h) printf '%s\n' 'dv manager start <repo> [--agent hermes] | status [repo] [--json] | stop <repo>' 'dv host check [--json] [--probe-codex] | sync' 'dv submit <repo> <ISSUE> <slug> --brief FILE [--agent codex|claude|devin] [--base BRANCH] [--mode goal|exec]' 'dv bid --json [--repo REPO] [--agent AGENT]' 'dv queue [ISSUE] [--json]' 'dv cancel <ISSUE>' 'dv start <repo> <ISSUE> <slug> [--agent codex|claude|devin] [--brief FILE] [--base BRANCH] [--mode goal|exec]' 'dv done <ISSUE> [--note TEXT]' 'dv pr|pr-wait|polish|review|land|clean <ISSUE>' 'dv metrics [--since 6h] [--json]' 'dv status [ISSUE] [--json]' 'dv send <ISSUE> <text>' 'dv kick <kind> <ISSUE> [msg]' ;;
  *) fail "unknown command: $command" ;;
esac
