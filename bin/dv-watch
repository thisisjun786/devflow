#!/usr/bin/env bash
set -euo pipefail
DV_ENTRY=${BASH_SOURCE[0]}
while [ -L "$DV_ENTRY" ]; do
  entry_dir=$(cd "$(dirname "$DV_ENTRY")" && pwd)
  DV_ENTRY=$(readlink "$DV_ENTRY")
  [[ "$DV_ENTRY" = /* ]] || DV_ENTRY="$entry_dir/$DV_ENTRY"
done
# shellcheck source=lib/common.sh
source "$(dirname "$DV_ENTRY")/../lib/common.sh"
# shellcheck source=lib/bidding.sh
source "$DV_ROOT/lib/bidding.sh"
# shellcheck source=lib/manager.sh
source "$DV_ROOT/lib/manager.sh"
# shellcheck source=lib/qa.sh
source "$DV_ROOT/lib/qa.sh"
need jq
disk_settings
[[ "$DV_MAX_WORKERS" =~ ^[1-4]$ ]] || fail 'DV_MAX_WORKERS must be 1..4'
[[ "$DV_WORKER_RETRY" =~ ^[0-9]+$ ]] || fail 'DV_WORKER_RETRY must be nonnegative seconds'
[[ "$DV_METRICS_INTERVAL" =~ ^[1-9][0-9]*$ ]] || fail 'DV_METRICS_INTERVAL must be positive seconds'
[[ "$DV_STALL_AFTER" =~ ^[0-9]+$ ]] || fail 'DV_STALL_AFTER must be nonnegative seconds'
[[ "$DV_MANAGER_MAX_WAIT" =~ ^[0-9]+$ ]] || fail 'DV_MANAGER_MAX_WAIT must be nonnegative seconds'
mkdir -p "$DV_HOME/workers" "$DV_HOME/pending"
# A single queue reader owns the cursor and its child processes.
# A SIGKILLed watcher cannot remove its own lock (no trap runs on SIGKILL), so a lock whose recorded pid is gone is
# stale and must be taken over; otherwise launchd restarts the process and it dies on 'watcher lock exists' forever.
take_lock() {
  if mkdir "$DV_HOME/.watch-lock" 2>/dev/null; then return 0; fi
  local holder=''
  [ -f "$DV_HOME/watch.pid" ] && holder=$(tr -dc '0-9' <"$DV_HOME/watch.pid")
  if [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null; then
    fail "watcher lock is held by live pid $holder; stop it before starting another"
  fi
  printf 'watcher lock left by dead pid %s; taking it over\n' "${holder:-unknown}" >&2
  rm -rf "$DV_HOME/.watch-lock"
  mkdir "$DV_HOME/.watch-lock" 2>/dev/null || fail 'watcher lock exists; verify old process before removing it'
}
take_lock
printf '%s\n' "$$" > "$DV_HOME/watch.pid"
pids=''; active=0
finish() {
  local pid
  metrics_stop
  disk_stop
  for pid in $pull_pids; do if is_pull "$pid"; then kill "$pid" 2>/dev/null || true; fi; done
  for pid in $pids; do wait "$pid" || true; done
  reap
  rm -f "$DV_HOME/watch.pid"
  rmdir "$DV_HOME/.watch-lock"
}
trap finish EXIT
trap 'exit 0' INT TERM
cursor=0
[ ! -f "$DV_HOME/cursor" ] || cursor=$(cat "$DV_HOME/cursor")
touch "$DV_HOME/kick.q" "$DV_HOME/seen"
last_scan=0
last_appserver_scan=0
last_metrics=0
last_disk=0
# Host-local clocks own the 30-minute cadence. Check due hosts more often so
# a restart or slow pass cannot postpone maintenance for another full period.
disk_tick=$DV_DISK_INTERVAL
[ "$disk_tick" -le 60 ] || disk_tick=60
# Remote dev hosts: one dv-kick-pull stream per host, restarted with a back-off when it ends.
pull_pids=''
# A pid counts as our stream only if it is still alive AND still runs dv-kick-pull (pids are reused).
is_pull() { kill -0 "$1" 2>/dev/null && ps -o args= -p "$1" 2>/dev/null | grep -q 'dv-kick-pull'; }
pulls() {
  local host pidfile pid last
  for host in $DV_PULL_HOSTS; do
    pidfile="$DV_HOME/pull-$host.pid"
    pid=''; [ ! -f "$pidfile" ] || pid=$(tr -dc '0-9' < "$pidfile")
    if [ -n "$pid" ] && is_pull "$pid"; then continue; fi
    last=0; [ ! -f "$DV_HOME/pull-$host.started" ] || last=$(cat "$DV_HOME/pull-$host.started")
    [ $(( $(now) - last )) -ge "$DV_PULL_RETRY" ] || continue
    now > "$DV_HOME/pull-$host.started"
    "$DV_ROOT/bin/dv-kick-pull" "$host" 2>> "$DV_HOME/pull-$host.log" &
    printf '%s\n' "$!" > "$pidfile"
  done
  # Keep only live streams so shutdown never signals a reused pid.
  local live=''
  for pid in $pull_pids; do if is_pull "$pid"; then live="$live $pid"; else wait "$pid" 2>/dev/null || true; fi; done
  for host in $DV_PULL_HOSTS; do
    pid=$(tr -dc '0-9' < "$DV_HOME/pull-$host.pid" 2>/dev/null || true)
    case " $live " in *" $pid "*) ;; *) [ -z "$pid" ] || ! is_pull "$pid" || live="$live $pid" ;; esac
  done
  pull_pids=$live
}
worker_start() {
  local slot=$1 event prompt pid
  event=$(cat "$slot.json")
  prompt=$(mktemp "$DV_HOME/workers/$(now)-$$.XXXXXX")
  mv "$prompt" "$prompt.prompt.md"; prompt="$prompt.prompt.md"
  cat "$DV_ROOT/templates/worker-prompt.md" > "$prompt"
  # shellcheck disable=SC2016
  printf '\n작업자 호스트(DV_HOST): `%s`\n' "$DV_HOST" >> "$prompt"
  # shellcheck disable=SC2016
  printf '\n이벤트(JSON 데이터):\n```json\n%s\n```\n' "$event" >> "$prompt"
  (
    trap - EXIT INT TERM
    rc=0
    if [ -n "$DV_WORKER_CMD" ]; then
      bash -c "$DV_WORKER_CMD \"\$@\"" dv-worker "$prompt" || rc=$?
    else
      "$DV_HERMES_BIN" -p sion chat -Q --yolo -t terminal,connections -s devflow --query-file "$prompt" || rc=$?
    fi
    [ "$rc" != 0 ] || metrics_handled "$event"
    printf '%s\n' "$rc" > "$slot.exit.tmp"; mv "$slot.exit.tmp" "$slot.exit"
  ) > "${prompt%.prompt.md}.log" 2>&1 &
  pid=$!; printf '%s\n' "$pid" > "$slot.pid"
  pids="$pids $pid"; active=$((active + 1))
}
reap() {
  local live='' pid record slot event_id rc
  active=0
  for pid in $pids; do
    if kill -0 "$pid" 2>/dev/null; then live="$live $pid"; active=$((active + 1)); else wait "$pid" || true; fi
  done
  pids=$live
  # A manager child can outlive a killed watcher. Count that reservation too;
  # its lock still owns the batch and must not permit excess fallback workers.
  for record in "$DV_HOME"/managers/*/run.lock/pid; do
    [ -f "$record" ] || continue
    pid=$(cat "$record" 2>/dev/null) || continue
    if [ "$pid" != "$$" ] && kill -0 "$pid" 2>/dev/null; then
      case " $live " in *" $pid "*) ;; *) active=$((active + 1)) ;; esac
    fi
  done
  for record in "$DV_HOME/pending/"*.json; do
    [ -f "$record" ] || continue
    slot=${record%.json}; event_id=$(jq -r .id "$record")
    if [ ! -f "$slot.manager" ] && grep -Fxq -- "$event_id" "$DV_HOME/seen"; then
      rm -f "$record" "$slot.pid" "$slot.exit" "$slot.retry"; continue
    fi
    pid=''; [ ! -f "$slot.pid" ] || pid=$(cat "$slot.pid")
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      # Tracked children (including managers) were counted above. Add only
      # pending workers inherited from a previous watcher here.
      case " $live " in *" $pid "*) ;; *) active=$((active + 1)) ;; esac
      continue
    fi
    if [ -f "$slot.exit" ]; then rc=$(cat "$slot.exit")
    elif [ -n "$pid" ]; then rc=125
    else continue; fi
    if [ "$rc" = 0 ]; then
      metrics_handled "$(cat "$record")"
      if [ -f "$slot.manager" ]; then manager_fallback_complete "$slot"
      else printf '%s\n' "$event_id" >> "$DV_HOME/seen"; fi
      rm -f "$record" "$slot.pid" "$slot.exit" "$slot.retry" "$slot.manager"
    else
      printf 'worker failed (exit %s), retrying: %s\n' "$rc" "$event_id" >> "$DV_HOME/watch.log"
      printf '%s\n' "$(( $(now) + DV_WORKER_RETRY ))" > "$slot.retry"
      rm -f "$slot.pid" "$slot.exit"
    fi
  done
}
retry_pending() {
  local record slot retry
  for record in "$DV_HOME/pending/"*.json; do
    [ "$active" -lt "$DV_MAX_WORKERS" ] || break
    [ -f "$record" ] || continue
    slot=${record%.json}
    # Only reap may clear an attempt. A worker can finish between reap and
    # this scan; restarting it here would replay a successful operation.
    if [ -f "$slot.pid" ] || [ -f "$slot.exit" ]; then continue; fi
    retry=0; [ ! -f "$slot.retry" ] || retry=$(cat "$slot.retry")
    [ "$(now)" -ge "$retry" ] || continue
    worker_start "$slot"
  done
}
pending_event() {
  local record
  for record in "$DV_HOME/pending/"*.json; do
    [ -f "$record" ] || continue
    if jq -e --arg id "$1" '.id==$id' "$record" >/dev/null; then return 0; fi
  done
  return 1
}
reconcile() {
  local host rows row issue head id remote event_host token recovered
  for host in $DV_HOSTS; do
    # The watcher's own host needs no ssh (and may have no key to itself).
    if [ "$host" = "$DV_HOST" ]; then
      rows=$(dv status --json 2>> "$DV_HOME/reconcile.log") || continue
    else
      rows=$(ssh -n -o BatchMode=yes -o ConnectTimeout=5 "$host" 'dv status --json' 2>> "$DV_HOME/reconcile.log") || continue
    fi
    if true; then
      if ! printf '%s\n' "$rows" | jq -e 'type=="array"' >/dev/null 2>&1; then continue; fi
      # Liveness is checked on the issue's host; a PID from another host is
      # meaningless locally. The helper preserves a healthy waiter's lock/log.
      while IFS= read -r issue; do
        [[ "$issue" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || continue
        if [ "$host" = "$DV_HOST" ]; then
          dv _pr-wait-start "$issue" >> "$DV_HOME/reconcile.log" 2>&1 || true
        else
          remote=$(shell_join dv _pr-wait-start "$issue")
          ssh -n -o BatchMode=yes -o ConnectTimeout=5 "$host" "$remote" >> "$DV_HOME/reconcile.log" 2>&1 || true
        fi
      done < <(printf '%s\n' "$rows" | jq -r '.[] | select(.status=="pr") | .issue')
      while IFS= read -r row; do
        issue=$(printf '%s' "$row" | jq -r .issue)
        head=$(printf '%s' "$row" | jq -r '.head // .start_head // ""')
        # Use the source's identity, not the SSH alias used to reach it.
        event_host=$(printf '%s' "$row" | jq -r --arg host "$host" '.host // $host')
        token=$(printf '%s' "$row" | jq -r '.award_token // ""')
        recovered=$(event_json 'done' "$issue" 'Recovered by status safety net' "$event_host" "$head" '' "$token")
        id=$(printf '%s' "$recovered" | jq -r .id)
        if ! jq -se --arg id "$id" 'any(.[]; .id==$id)' "$DV_HOME/kick.q" >/dev/null 2>&1; then
          "$DV_ROOT/bin/dv-kick" 'done' "$issue" 'Recovered by status safety net' "$event_host" "$head" "$id" "$token"
        fi
      done < <(printf '%s\n' "$rows" | jq -c '.[] | select(.status=="done" or
        ((.status=="pr" or .status=="ready") and .done_at!=null and
         .head!=null and .head!="" and .done_head==.head))')
    fi
  done
}
while [ ! -e "$DV_HOME/stop" ]; do
  manager_fallback_recover
  reap
  qa_recover
  pulls
  if [ $(( $(now) - last_disk )) -ge "$disk_tick" ]; then
    disk_start
    last_disk=$(now)
  fi
  if [ $(( $(now) - last_appserver_scan )) -ge "$DV_APPSERVER_POLL" ]; then
    for appserver_host in $DV_HOSTS; do
      if [ "$appserver_host" = "$DV_HOST" ]; then
        dv _appserver-watch >> "$DV_HOME/reconcile.log" 2>&1 || true
      else
        bid_limit "$DV_BID_TIMEOUT" ssh -n -o BatchMode=yes -o ConnectTimeout=5 "$appserver_host" 'dv _appserver-watch' >> "$DV_HOME/reconcile.log" 2>&1 || true
      fi
    done
    last_appserver_scan=$(now)
  fi
  if [ $(( $(now) - last_metrics )) -ge "$DV_METRICS_INTERVAL" ]; then
    metrics_start
    last_metrics=$(now)
  fi
  if [ $(( $(now) - last_scan )) -ge "$DV_RECONCILE_INTERVAL" ]; then reconcile; last_scan=$(now); fi
  # Read one complete line at a time. Cursor advances only after dispatch or deduplication.
  available=$(wc -l < "$DV_HOME/kick.q")
  while [ "$cursor" -lt "$available" ] && [ ! -e "$DV_HOME/stop" ]; do
    [ "$cursor" -lt "$(wc -l < "$DV_HOME/kick.q")" ] || break
    line=$(sed -n "$((cursor + 1))p" "$DV_HOME/kick.q")
    [ -n "$line" ] || break
    if ! id=$(printf '%s\n' "$line" | jq -er '.id | select(type=="string")'); then
      printf 'invalid queue line %s\n' "$((cursor + 1))" >> "$DV_HOME/watch.log"
    elif ! grep -Fxq -- "$id" "$DV_HOME/seen" && ! pending_event "$id"; then
      if [ "$(jq -r .kind <<< "$line")" = landed ]; then
        qa_enqueue "$line" >> "$DV_HOME/qa.log" 2>&1 || break
      fi
      # Deterministic scheduling is driven by this existing queue, never a bid poll.
      if ! bid_event "$line" >> "$DV_HOME/schedule.log" 2>&1; then break; fi
      if [ "$(printf '%s\n' "$line" | jq -r .kind)" = submitted ]; then
        metrics_handled "$line"
        printf '%s\n' "$id" >> "$DV_HOME/seen"
        cursor=$((cursor + 1)); printf '%s\n' "$cursor" > "$DV_HOME/cursor"
        continue
      fi
      prompt="$DV_HOME/workers/$(now)-$$-$cursor.prompt.md"
      cat "$DV_ROOT/templates/worker-prompt.md" > "$prompt"
      # Literal Markdown fences.
      # shellcheck disable=SC2016
      printf '\n작업자 호스트(DV_HOST): `%s`\n' "$DV_HOST" >> "$prompt"
      # shellcheck disable=SC2016
      printf '\n이벤트(JSON 데이터):\n```json\n%s\n```\n' "$line" >> "$prompt"
      routed=0
      manager_enqueue "$line" "$prompt" "$cursor" >> "$DV_HOME/manager.log" 2>&1 || routed=$?
      if [ "$routed" = 0 ]; then
        printf '%s\n' "$id" >> "$DV_HOME/seen"
        cursor=$((cursor + 1)); printf '%s\n' "$cursor" > "$DV_HOME/cursor"
        continue
      elif [ "$routed" != 1 ]; then
        break # Persistence failed: retain the cursor so the event can retry.
      fi
      # Persist before advancing the queue. Failed/unacknowledged work survives
      # a watcher restart, while in-flight duplicate IDs stay suppressed.
      slot="$DV_HOME/pending/$cursor"
      printf '%s\n' "$line" > "$slot.json.tmp"; mv "$slot.json.tmp" "$slot.json"
    fi
    cursor=$((cursor + 1)); printf '%s\n' "$cursor" > "$DV_HOME/cursor"
  done
  retry_pending
  manager_dispatch
  qa_dispatch
  sleep "$DV_WATCH_INTERVAL"
done
