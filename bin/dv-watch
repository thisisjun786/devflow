#!/usr/bin/env bash
set -euo pipefail
DV_ENTRY=${BASH_SOURCE[0]}
while [ -L "$DV_ENTRY" ]; do
  entry_dir=$(cd "$(dirname "$DV_ENTRY")" && pwd)
  DV_ENTRY=$(readlink "$DV_ENTRY")
  [[ "$DV_ENTRY" = /* ]] || DV_ENTRY="$entry_dir/$DV_ENTRY"
done
watch_commit=$(git -C "$(dirname "$DV_ENTRY")/.." rev-parse HEAD 2>/dev/null || true)
# shellcheck source=lib/common.sh
source "$(dirname "$DV_ENTRY")/../lib/common.sh"
tmp_agent_environment
# shellcheck source=lib/bidding.sh
source "$DV_ROOT/lib/bidding.sh"
# shellcheck source=lib/manager.sh
source "$DV_ROOT/lib/manager.sh"
# shellcheck source=lib/autofill.sh
source "$DV_ROOT/lib/autofill.sh"
# shellcheck source=lib/stall.sh
source "$DV_ROOT/lib/stall.sh"
# shellcheck source=lib/stack.sh
source "$DV_ROOT/lib/stack.sh"
# shellcheck source=lib/qa.sh
source "$DV_ROOT/lib/qa.sh"
# shellcheck source=lib/self-update.sh
source "$DV_ROOT/lib/self-update.sh"
# shellcheck source=lib/reconcile.sh
source "$DV_ROOT/lib/reconcile.sh"
watch_auto_update=$DV_AUTO_UPDATE
# Child CLI calls must not pull while their parent is dispatching an event.
export DV_AUTO_UPDATE=0
need jq
disk_settings
[[ "$DV_MAX_WORKERS" =~ ^[1-8]$ ]] || fail 'DV_MAX_WORKERS must be 1..8'
[[ "$DV_WORKER_RETRY" =~ ^[0-9]+$ ]] || fail 'DV_WORKER_RETRY must be nonnegative seconds'
[[ "$DV_METRICS_INTERVAL" =~ ^[1-9][0-9]*$ ]] || fail 'DV_METRICS_INTERVAL must be positive seconds'
[[ "$DV_STALL_AFTER" =~ ^[1-9][0-9]*$ ]] || fail 'DV_STALL_AFTER must be a positive integer'
[[ "$DV_STATUS_TIMEOUT" =~ ^[1-9][0-9]*$ ]] || fail 'DV_STATUS_TIMEOUT must be positive seconds'
# Share the existing status safety net; do not leave a ten-minute stall waiting
# for the old thirty-minute reconciliation interval. No extra process needed.
stall_scan_interval=60
[ "$DV_STALL_AFTER" -ge "$stall_scan_interval" ] || stall_scan_interval=$DV_STALL_AFTER
[ "$DV_RECONCILE_INTERVAL" -ge "$stall_scan_interval" ] || stall_scan_interval=$DV_RECONCILE_INTERVAL
[[ "$DV_MANAGER_MAX_WAIT" =~ ^[0-9]+$ ]] || fail 'DV_MANAGER_MAX_WAIT must be nonnegative seconds'
mkdir -p "$DV_HOME/workers" "$DV_HOME/pending"
# A single queue reader owns the cursor and its child processes.
# A SIGKILLed watcher cannot remove its own lock (no trap runs on SIGKILL), so a lock whose recorded pid is gone is
# stale and must be taken over; otherwise launchd restarts the process and it dies on 'watcher lock exists' forever.
take_lock() {
  if mkdir "$DV_HOME/.watch-lock" 2>/dev/null; then return 0; fi
  local holder=''
  [ -f "$DV_HOME/watch.pid" ] && holder=$(tr -dc '0-9' <"$DV_HOME/watch.pid")
  # exec retains the PID and lock; other processes must still refuse it.
  if [ "${DV_WATCH_REEXEC_PID:-}" = "$$" ] && [ "$holder" = "$$" ]; then return 0; fi
  if [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null; then
    fail "watcher lock is held by live pid $holder; stop it before starting another"
  fi
  printf 'watcher lock left by dead pid %s; taking it over\n' "${holder:-unknown}" >&2
  rm -rf "$DV_HOME/.watch-lock"
  mkdir "$DV_HOME/.watch-lock" 2>/dev/null || fail 'watcher lock exists; verify old process before removing it'
}
take_lock
printf '%s\n' "$$" > "$DV_HOME/watch.pid"
pids=${DV_WATCH_REEXEC_PIDS:-}; manager_pids=${DV_WATCH_REEXEC_MANAGER_PIDS:-}; active=0
unset DV_WATCH_REEXEC_PID DV_WATCH_REEXEC_PIDS DV_WATCH_REEXEC_MANAGER_PIDS
self_update_watch_version "$watch_commit"
finish() {
  local pid
  metrics_stop
  disk_stop
  reconcile_stop
  for pid in $pull_pids; do if is_pull "$pid"; then kill "$pid" 2>/dev/null || true; fi; done
  for pid in $pids $manager_pids; do
    # After exec, bash no longer has the old child job table.
    while qa_alive "$pid"; do sleep 0.1; done
    wait "$pid" 2>/dev/null || true
  done
  reap
  rm -f "$DV_HOME/watch.pid"
  rmdir "$DV_HOME/.watch-lock"
}
trap finish EXIT
trap 'exit 0' INT TERM
cursor=0
[ ! -f "$DV_HOME/cursor" ] || cursor=$(cat "$DV_HOME/cursor")
touch "$DV_HOME/kick.q" "$DV_HOME/seen"
last_scan=${DV_WATCH_LAST_SCAN:-0}
unset DV_WATCH_LAST_SCAN DV_WATCH_LAST_STALL_SCAN
update_requested=0
last_metrics=0
last_disk=0
# Host-local clocks own the 30-minute cadence. Check due hosts more often so
# a restart or slow pass cannot postpone maintenance for another full period.
disk_tick=$DV_DISK_INTERVAL
[ "$disk_tick" -le 60 ] || disk_tick=60
# Remote dev hosts: one dv-kick-pull stream per host, restarted with a back-off when it ends.
pull_pids=''
# A pid counts as our stream only if it is still alive AND still runs dv-kick-pull (pids are reused).
is_pull() { kill -0 "$1" 2>/dev/null && ps -o args= -p "$1" 2>/dev/null | grep -q 'dv-kick-pull'; }
pulls() {
  local host pidfile pid last
  for host in $DV_PULL_HOSTS; do
    pidfile="$DV_HOME/pull-$host.pid"
    pid=''; [ ! -f "$pidfile" ] || pid=$(tr -dc '0-9' < "$pidfile")
    if [ -n "$pid" ] && is_pull "$pid"; then continue; fi
    last=0; [ ! -f "$DV_HOME/pull-$host.started" ] || last=$(cat "$DV_HOME/pull-$host.started")
    [ $(( $(now) - last )) -ge "$DV_PULL_RETRY" ] || continue
    now > "$DV_HOME/pull-$host.started"
    "$DV_ROOT/bin/dv-kick-pull" "$host" 2>> "$DV_HOME/pull-$host.log" &
    printf '%s\n' "$!" > "$pidfile"
  done
  # Keep only live streams so shutdown never signals a reused pid.
  local live=''
  for pid in $pull_pids; do if is_pull "$pid"; then live="$live $pid"; else wait "$pid" 2>/dev/null || true; fi; done
  for host in $DV_PULL_HOSTS; do
    pid=$(tr -dc '0-9' < "$DV_HOME/pull-$host.pid" 2>/dev/null || true)
    case " $live " in *" $pid "*) ;; *) [ -z "$pid" ] || ! is_pull "$pid" || live="$live $pid" ;; esac
  done
  pull_pids=$live
}
worker_start() {
  local slot=$1 event prompt pid
  event=$(cat "$slot.json")
  prompt=$(mktemp "$DV_HOME/workers/$(now)-$$.XXXXXX")
  mv "$prompt" "$prompt.prompt.md"; prompt="$prompt.prompt.md"
  cat "$DV_ROOT/templates/worker-prompt.md" > "$prompt"
  # shellcheck disable=SC2016
  printf '\n작업자 호스트(DV_HOST): `%s`\n' "$DV_HOST" >> "$prompt"
  # shellcheck disable=SC2016
  printf '\n이벤트(JSON 데이터):\n```json\n%s\n```\n' "$event" >> "$prompt"
  (
    trap - EXIT INT TERM
    rc=0
    if printf '%s\n' "$event" | jq -e '.kind=="stack-land" or .kind=="stack-resume"' >/dev/null; then
      stack_worker "$event" || rc=$?
    elif [ -n "$DV_WORKER_CMD" ]; then
      bash -c "$DV_WORKER_CMD \"\$@\"" dv-worker "$prompt" || rc=$?
    else
      "$DV_HERMES_BIN" -p sion chat -Q --yolo -t terminal,connections -s devflow --query-file "$prompt" || rc=$?
    fi
    [ "$rc" != 0 ] || metrics_handled "$event"
    printf '%s\n' "$rc" > "$slot.exit.tmp"; mv "$slot.exit.tmp" "$slot.exit"
  ) > "${prompt%.prompt.md}.log" 2>&1 &
  pid=$!; printf '%s\n' "$pid" > "$slot.pid"
  pids="$pids $pid"; active=$((active + 1))
}
reap() {
  local live='' pid record slot event_id rc
  active=0
  for pid in $pids; do
    if qa_alive "$pid"; then live="$live $pid"; active=$((active + 1)); else wait "$pid" 2>/dev/null || true; fi
  done
  pids=$live
  live=''
  for pid in $manager_pids; do
    if qa_alive "$pid"; then live="$live $pid"; else wait "$pid" 2>/dev/null || true; fi
  done
  manager_pids=$live
  # Inherited enabled managers retain their per-repo reservation, without
  # consuming worker slots. Disabled-manager batches use ordinary workers.
  for record in "$DV_HOME"/managers/*/run.lock/pid; do
    [ -f "$record" ] || continue
    jq -e .enabled "${record%/run.lock/pid}/meta.json" >/dev/null && continue
    pid=$(cat "$record" 2>/dev/null) || continue
    if [ "$pid" != "$$" ] && kill -0 "$pid" 2>/dev/null; then
      case " $pids " in *" $pid "*) ;; *) active=$((active + 1)) ;; esac
    fi
  done
  for record in "$DV_HOME/pending/"*.json; do
    [ -f "$record" ] || continue
    slot=${record%.json}; event_id=$(jq -r .id "$record")
    if [ ! -f "$slot.manager" ] && grep -Fxq -- "$event_id" "$DV_HOME/seen"; then
      rm -f "$record" "$slot.pid" "$slot.exit" "$slot.retry"; continue
    fi
    pid=''; [ ! -f "$slot.pid" ] || pid=$(cat "$slot.pid")
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      # Tracked ordinary children were counted above. Add only
      # pending workers inherited from a previous watcher here.
      case " $pids " in *" $pid "*) ;; *) active=$((active + 1)) ;; esac
      continue
    fi
    if [ -f "$slot.exit" ]; then rc=$(cat "$slot.exit")
    elif [ -n "$pid" ]; then rc=125
    else continue; fi
    if stack_deferred "$record" "$rc"; then continue; fi
    if [ "$rc" = 0 ]; then
      metrics_handled "$(cat "$record")"
      if [ -f "$slot.manager" ]; then manager_fallback_complete "$slot"
      else printf '%s\n' "$event_id" >> "$DV_HOME/seen"; fi
      rm -f "$record" "$slot.pid" "$slot.exit" "$slot.retry" "$slot.manager"
    else
      printf 'worker failed (exit %s), retrying: %s\n' "$rc" "$event_id" >> "$DV_HOME/watch.log"
      printf '%s\n' "$(( $(now) + DV_WORKER_RETRY ))" > "$slot.retry"
      rm -f "$slot.pid" "$slot.exit"
    fi
  done
}
retry_pending() {
  local record slot retry
  for record in "$DV_HOME/pending/"*.json; do
    [ "$active" -lt "$DV_MAX_WORKERS" ] || break
    [ -f "$record" ] || continue
    slot=${record%.json}
    # Only reap may clear an attempt. A worker can finish between reap and
    # this scan; restarting it here would replay a successful operation.
    if [ -f "$slot.pid" ] || [ -f "$slot.exit" ]; then continue; fi
    retry=0; [ ! -f "$slot.retry" ] || retry=$(cat "$slot.retry")
    [ "$(now)" -ge "$retry" ] || continue
    worker_start "$slot"
  done
}
pending_event() {
  local record
  for record in "$DV_HOME/pending/"*.json; do
    [ -f "$record" ] || continue
    if jq -e --arg id "$1" '.id==$id' "$record" >/dev/null; then return 0; fi
  done
  return 1
}
stall_cursor=''; stall_started=0; stall_reported=0
watch_stall() {
  local reason=$1 stalled_event=$2 issue message time
  if [ -z "$reason" ]; then stall_cursor=''; stall_reported=0; return 0; fi
  time=$(now)
  if [ "$stall_cursor" != "$cursor" ]; then
    stall_cursor=$cursor; stall_started=$time; stall_reported=0
  fi
  [ "$stall_reported" = 0 ] && [ $((time - stall_started)) -gt "$DV_STALL_AFTER" ] || return 0
  issue=$(jq -er '.issue | select(type=="string" and test("^[A-Za-z0-9][A-Za-z0-9_-]*$"))' <<< "$stalled_event" 2>/dev/null) || issue=unknown
  message="watcher-stuck: line $((cursor + 1)): $reason (issue $issue, unchanged for $((time - stall_started))s)"
  printf '%s\n' "$message" >&2
  printf '%s\n' "$message" >> "$DV_HOME/watch.log"
  # Persist via the existing queue and event log. stderr stays visible even
  # while the blocked line prevents dispatching the alarm to a worker.
  # Use a watcher-scoped issue so this alarm cannot supersede the blocked
  # issue's real event when a manager later coalesces its batch.
  if "$DV_ROOT/bin/dv-kick" watcher-stuck WATCHER "$message" "$DV_HOST" '' \
    "$DV_HOST:watcher-stuck:$$:$cursor:$stall_started"; then stall_reported=1; fi
}
while [ ! -e "$DV_HOME/stop" ]; do
  autofill_sweep=0
  reap
  qa_recover
  pulls
  host_capacity_tick >> "$DV_HOME/autofill.log" 2>&1 || true
  if [ $(( $(now) - last_disk )) -ge "$disk_tick" ]; then
    disk_start
    last_disk=$(now)
  fi
  if [ $(( $(now) - last_metrics )) -ge "$DV_METRICS_INTERVAL" ]; then
    metrics_start
    last_metrics=$(now)
  fi
  reconcile_start
  # Frequent stall scans must not shorten the self-update safety interval.
  if [ $(( $(now) - last_scan )) -ge "$DV_RECONCILE_INTERVAL" ]; then
    last_scan=$(now); update_requested=1; autofill_sweep=1
  fi
  # Read one complete line at a time. Cursor advances only after dispatch or deduplication.
  available=$(wc -l < "$DV_HOME/kick.q")
  reconcile_requested=0
  stall_reason=''; line=''
  while [ "$cursor" -lt "$available" ] && [ ! -e "$DV_HOME/stop" ]; do
    if [ "$cursor" -ge "$(wc -l < "$DV_HOME/kick.q")" ]; then stall_reason='queue shortened before read'; break; fi
    line=$(sed -n "$((cursor + 1))p" "$DV_HOME/kick.q")
    if [ -z "$line" ]; then stall_reason='empty queue line'; break; fi
    if ! id=$(printf '%s\n' "$line" | jq -er '.id | select(type=="string")'); then
      printf 'invalid queue line %s\n' "$((cursor + 1))" >> "$DV_HOME/watch.log"
    elif ! grep -Fxq -- "$id" "$DV_HOME/seen" && ! pending_event "$id"; then
      # Existing queue receipts release slots before filling them again.
      if ! bid_event "$line" >> "$DV_HOME/schedule.log" 2>&1; then stall_reason='bid_event failed'; break; fi
      if [ "$(jq -r .kind <<< "$line")" = landed ]; then
        if ! qa_enqueue "$line" >> "$DV_HOME/qa.log" 2>&1; then stall_reason='qa_enqueue failed'; break; fi
      fi
      autofill_event "$line" >> "$DV_HOME/autofill.log" 2>&1 || true
      # Stack candidates are discovered by the bounded host reconciliation.
      # Never repeat an inline fleet status scan for each done/landed event.
      case "$(printf '%s\n' "$line" | jq -r .kind)" in done|landed) reconcile_requested=1 ;; esac
      case "$(jq -r .kind <<< "$line")" in
      submitted|bid-changed|issue-opened|issue-closed|issue-reopened|issue-edited|issue-labeled|issue-unlabeled|pr-opened|pr-closed)
        metrics_handled "$line"
        printf '%s\n' "$id" >> "$DV_HOME/seen"
        cursor=$((cursor + 1)); printf '%s\n' "$cursor" > "$DV_HOME/cursor"
        continue
        ;;
      esac
      prompt="$DV_HOME/workers/$(now)-$$-$cursor.prompt.md"
      cat "$DV_ROOT/templates/worker-prompt.md" > "$prompt"
      # Literal Markdown fences.
      # shellcheck disable=SC2016
      printf '\n작업자 호스트(DV_HOST): `%s`\n' "$DV_HOST" >> "$prompt"
      # shellcheck disable=SC2016
      printf '\n이벤트(JSON 데이터):\n```json\n%s\n```\n' "$line" >> "$prompt"
      routed=0
      manager_enqueue "$line" "$prompt" "$cursor" >> "$DV_HOME/manager.log" 2>&1 || routed=$?
      if [ "$routed" = 0 ]; then
        printf '%s\n' "$id" >> "$DV_HOME/seen"
        cursor=$((cursor + 1)); printf '%s\n' "$cursor" > "$DV_HOME/cursor"
        if self_update_landed "$line"; then update_requested=1; fi
        continue
      elif [ "$routed" != 1 ]; then
        stall_reason="manager_enqueue failed (exit $routed)"
        break # Persistence failed: retain the cursor so the event can retry.
      fi
      # Persist before advancing the queue. Failed/unacknowledged work survives
      # a watcher restart, while in-flight duplicate IDs stay suppressed.
      slot="$DV_HOME/pending/$cursor"
      if ! printf '%s\n' "$line" > "$slot.json.tmp" || ! mv "$slot.json.tmp" "$slot.json"; then
        stall_reason='worker queue persistence failed'; break
      fi
    fi
    cursor=$((cursor + 1)); printf '%s\n' "$cursor" > "$DV_HOME/cursor"
    if self_update_landed "$line"; then update_requested=1; fi
  done
  watch_stall "$stall_reason" "$line"
  # Coalesce a batch of landed/done wakeups, including events arriving while
  # a host is busy, into one following pass through the same host slot.
  if [ "$reconcile_requested" = 1 ]; then reconcile_request; fi
  # Resolve legacy slot conflicts before handing fallback records to workers.
  manager_conflict_recover
  manager_fallback_recover
  retry_pending
  manager_dispatch
  qa_dispatch
  # One existing, slow reconciliation sweep backs up committed event hooks.
  # Idle queue ticks do not query GitHub or hosts for autofill.
  if [ "$autofill_sweep" = 1 ]; then autofill_tick >> "$DV_HOME/autofill.log" 2>&1 || true; fi
  # All events have durable cursor/pending state. Never run EXIT cleanup here:
  # workers, manager turns, QA and pull streams keep their existing handles.
  if [ ! -e "$DV_HOME/stop" ]; then
    if [ "$update_requested" = 1 ]; then DV_AUTO_UPDATE=$watch_auto_update self_update 0; update_requested=0; fi
    if [ "$(self_update_head)" != "$watch_commit" ]; then
      metrics_stop
      export DV_WATCH_REEXEC_PID=$$ DV_WATCH_REEXEC_PIDS=$pids DV_WATCH_LAST_SCAN=$last_scan
      export DV_WATCH_REEXEC_MANAGER_PIDS=$manager_pids
      export DV_AUTO_UPDATE=$watch_auto_update
      exec "$DV_ROOT/bin/dv-watch" "$@"
    fi
  fi
  sleep "$DV_WATCH_INTERVAL"
done
