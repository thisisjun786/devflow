#!/usr/bin/env bash
# herdr 0.9.1 CLI contract, measured by CRW-1698's live probes:
# JSON success envelopes on stdout; errors on stderr + exit 1;
# run/send-keys are silent, read is raw text (no added newline).
set -euo pipefail
stub="$CASE_DIR/herdr"
mkdir -p "$stub"
printf '%s\n' "$@" | jq -R . | jq -sc . >> "$stub/calls"
request="cli:$1:$2"
case "$1 $2" in 'pane run'|'pane send-keys') request=cli:request ;; esac
error() {
  jq -cn --arg id "$request" --arg code "$1" --arg message "$2" \
    '{error:{code:$code,message:$message},id:$id}' >&2
  exit 1
}
# Explicit transport fault injection, separate from simulated server replies.
if [ -f "$stub/fail" ] && [ "$(cat "$stub/fail")" = "$1 $2" ]; then exit 1; fi
if [ "$1 $2" != 'workspace create' ]; then
  id=${3%%:*}; dir="$stub/$id"
  if [ "$1 $2" = 'pane process-info' ]; then id=${4%%:*}; dir="$stub/$id"; fi
  if [ ! -f "$dir/workspace" ]; then
    if [ "$1" = agent ]; then error agent_not_found "agent target $3 not found"
    else error "${1}_not_found" "$1 $3 not found"; fi
  fi
fi
if [ "$1" = pane ] && [ -f "$dir/missing-pane" ]; then error pane_not_found "pane $3 not found"; fi
pane_json() {
  jq -c '.result.root_pane' "$dir/workspace"
}
agent_json() {
  local status=idle agent seq=1 session=''
  [ ! -f "$dir/status" ] || status=$(cat "$dir/status")
  [ ! -f "$dir/seq" ] || seq=$(cat "$dir/seq")
  [ ! -f "$dir/session" ] || session=$(cat "$dir/session")
  agent=$(jq -r .agent "$DV_STATE/${id#w-}/meta")
  pane_json | jq -c --arg status "$status" --arg agent "$agent" \
    --arg session "$session" --argjson seq "$seq" 'del(.scroll) +
      {agent:$agent,agent_status:$status,state_change_seq:$seq} +
      (if $session=="" then {} else {agent_session:{kind:"id",value:$session}} end)'
}
agent_reply() {
  agent_json | jq -c --arg id "$request" --arg type "$1" '{id:$id,result:{agent:.,type:$type}}'
}
require_agent() {
  [ -f "$dir/detected" ] || error agent_not_found "agent target $3 not found"
}
case "$1 $2" in
  'workspace create')
    shift 2
    cwd=''; label=''; no_focus=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --cwd) cwd=$2; shift 2 ;;
        --label) label=$2; shift 2 ;;
        --no-focus) no_focus=1; shift ;;
        *) exit 1 ;;
      esac
    done
    test "$no_focus" = 1; test -d "$cwd"
    id="w-${label#dv-}"; dir="$stub/$id"
    mkdir "$dir"
    if [ -f "$stub/startup-mode" ]; then cp "$stub/startup-mode" "$dir/startup-mode"; fi
    jq -cn --arg id "$id" --arg label "$label" --arg cwd "$cwd" \
      '{id:"cli:workspace:create",result:{
        root_pane:{agent_status:"unknown",cwd:$cwd,focused:false,foreground_cwd:$cwd,pane_id:($id+":p1"),revision:0,
          scroll:{max_offset_from_bottom:0,offset_from_bottom:0,viewport_rows:40},tab_id:($id+":t1"),terminal_id:("term_"+$id),workspace_id:$id},
        tab:{agent_status:"unknown",focused:false,label:"1",number:1,pane_count:1,tab_id:($id+":t1"),workspace_id:$id},
        type:"workspace_created",workspace:{active_tab_id:($id+":t1"),agent_status:"unknown",focused:false,label:$label,
          number:2,pane_count:1,tab_count:1,workspace_id:$id}}}' > "$dir/workspace"
    printf '❯' > "$dir/output"
    cat "$dir/workspace" ;;
  'workspace get')
    jq -c '{id:"cli:workspace:get",result:{type:"workspace_info",workspace:.result.workspace}}' "$dir/workspace" ;;
  'workspace close')
    rm "$dir/workspace"
    printf '{"id":"cli:workspace:close","result":{"type":"ok"}}\n' ;;
  'pane wait-output')
    test "$3" = "$id:p1"
    shift 3; pattern=''; timeout=''; source=''
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --regex) pattern=$2; shift 2 ;;
        --source) source=$2; shift 2 ;;
        --timeout) timeout=$2; shift 2 ;;
        *) exit 1 ;;
      esac
    done
    test -n "$pattern"; test "$timeout" -gt 0
    if [ "$source" = visible ] && [ -f "$stub/late-detection" ]; then
      # Model the app banner appearing as the foreground agent is detected.
      printf 'Starting app...\n│ OpenAI Codex\n' > "$dir/output"
      touch "$dir/detected"
    else test "$source" = recent-unwrapped; fi
    # grep is line-oriented already; handle the old Rust multiline prefix too.
    pattern=${pattern#'(?m)'}
    # The remaining production pattern is POSIX ERE. Do not always succeed.
    matched=$(grep -E "$pattern" "$dir/output") || error timeout 'timed out waiting for output match'
    touch "$dir/ready"
    jq -cn --arg id "$request" --arg pane "$id:p1" --arg tab "$id:t1" --arg workspace "$id" \
      --arg matched "$matched" --arg text "$(cat "$dir/output")" \
      '{id:$id,result:{matched_line:$matched,pane_id:$pane,read:{format:"text",pane_id:$pane,revision:0,
        source:"recent_unwrapped",tab_id:$tab,text:$text,truncated:false,workspace_id:$workspace},revision:0,type:"output_matched"}}' ;;
  'pane run')
    test "$3" = "$id:p1"; test "$#" = 4; test -f "$dir/ready"
    # Hold a recovery after the launcher is requested but before it starts.
    if [ -f "$stub/recovery-hold" ]; then
      touch "$stub/recovery-entered"
      while [ -f "$stub/recovery-hold" ]; do sleep 0.05; done
    fi
    # Run only the configured fake agent, directly; no PTY/tmux or real agents.
    rm -f "$dir/exit"
    cwd=$(jq -r .result.root_pane.cwd "$dir/workspace")
    if [ -z "${DV_AGENT_CMD_codex:-}" ] && [ ! -f "$stub/late-detection" ]; then touch "$dir/detected"; fi
    (rc=0; (
      cd "$cwd"
      # A terminal server can have been started before authentication setup.
      if [ -f "$stub/drop-provider-env" ]; then unset DF43_TEST_TOKEN; fi
      bash -c "$4"
    ) || rc=$?; printf '%s\n' "$rc" > "$dir/exit") > "$dir/output" 2>&1 < /dev/null &
    printf '%s\n' "$!" > "$dir/pid" ;;
  'pane read')
    test "$4" = --source
    case "$5" in visible|recent-unwrapped) ;; *) exit 1 ;; esac
    # Show the agent's own output as the visible screen, as a real pane does.
    if [ "$5" = visible ] && [ -f "$stub/visible-output" ]; then cat "$dir/output"; exit; fi
    if [ "$5" = visible ] && [ -f "$dir/startup-mode" ]; then
      mode=$(cat "$dir/startup-mode")
      case "$mode" in
        folder) printf 'Folder access\nTrust this folder?\n› 1. Trust and continue\n  2. Quit\n'; exit ;;
        folder-late)
          if [ -f "$DV_STATE/${id#w-}/goal-input" ]; then
            printf 'Trusting will apply to the repository root:\nTrust this folder?\n› 1. Trust and continue\n'; exit
          fi ;;
        hook-modal)
          printf 'Hooks need review\n1 hook is new or changed.\nHooks can run outside the sandbox after you trust them.\n\n› 1. Review hooks\n  2. Trust all and continue\n  3. Continue without trusting (hooks won\047t run)\n\n  enter confirm · esc skip\n'; exit ;;
        hook) printf '1 hook needs review\nt trust all · enter review\n› \n'; exit ;;
        hook-actions) printf 't trust all · enter review\n› \n'; exit ;;
        hook-late)
          if [ -f "$DV_STATE/${id#w-}/goal-input" ]; then
            printf '2 hooks need review\nt trust all · enter review\n› '
            cat "$DV_STATE/${id#w-}/goal-input"; exit
          fi ;;
      esac
      if [ -f "$DV_STATE/${id#w-}/goal-input" ]; then
        case "$mode" in
          enter|enter-stuck)
            if [ ! -f "$dir/retry-enter" ] || [ "$mode" = enter-stuck ]; then
              printf '› '; fold -w 64 "$DV_STATE/${id#w-}/goal-input" | sed '2,$s/^/  /'
              printf '\n  gpt-6\n'; exit
            fi ;;
          screen-working) printf '• Pursuing goal\n› \n'; exit ;;
          history) cat "$DV_STATE/${id#w-}/goal-input"; printf '\n› \n'; exit ;;
        esac
      fi
      printf '› \n'; exit
    fi
    if [ "$#" -gt 5 ]; then test "$6" = --lines; tail -n "$7" "$dir/output"
    else cat "$dir/output"; fi ;;
  'pane send-keys')
    if [ "$4" = ctrl-c ]; then touch "$dir/interrupted"; exit; fi
    test "$4" = Enter
    if [ -f "$dir/startup-mode" ]; then
      touch "$dir/retry-enter"
      if [ "$(cat "$dir/startup-mode")" = enter ]; then printf 'working\n' > "$dir/status"; fi
      exit
    fi
    touch "$DV_STATE/${id#w-}/trust-enter" ;;
  'agent prompt')
    require_agent "$@"
    if [ -f "$stub/goal-mode" ] && [[ "$4" = '/goal '* ]]; then
      [ -f "$dir/goal-ready" ] || touch "$dir/early-prompt"
      count=0; [ ! -f "$dir/goal-attempts" ] || count=$(cat "$dir/goal-attempts")
      count=$((count + 1)); printf '%s\n' "$count" > "$dir/goal-attempts"
      if [ "$(cat "$stub/goal-mode")" != retry ] || [ "$count" = 1 ]; then
        error agent_not_ready "agent $3 is no longer the pane foreground process"
      fi
      if [ "$count" = 2 ]; then error agent_blocked "agent $3 is blocked and requires interactive input"; fi
    fi
    if [ -f "$stub/blocked" ]; then
      if [ "$(cat "$stub/blocked")" = once ]; then rm "$stub/blocked"; fi
      error agent_blocked "agent $3 is blocked and requires interactive input"
    fi
    if [ -f "$stub/prompt-error" ]; then error agent_not_ready "agent $3 is no longer the pane foreground process"; fi
    case "$4" in
      '/goal '*)
        printf '%s\n' "$4" > "$DV_STATE/${id#w-}/goal-input"
        if [ ! -f "$dir/startup-mode" ]; then printf 'working\n' > "$dir/status"; fi ;;
      *) printf '%s\n' "$4" >> "$DV_STATE/${id#w-}/sent-input" ;;
    esac
    agent_reply agent_prompted ;;
  'agent wait')
    require_agent "$@"
    if [ -f "$stub/question-mode" ]; then
      shift 3; untils=' '; timeout=0
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --until) untils="$untils$2 "; shift 2 ;;
          --timeout) timeout=$2; shift 2 ;;
          *) exit 1 ;;
        esac
      done
      trap 'rm -f "$stub/wait-$$.pid"' EXIT
      trap 'exit 0' TERM INT
      # A subscriber can be stopped as soon as it is visible to teardown.
      # Install cleanup before publishing the PID, including during startup.
      printf '%s\n' "$$" > "$stub/wait-$$.pid"
      # Let the exit test hold a live grace subscription until its agent has
      # finished. Completion work must not race a one-second wall-clock timer.
      if [[ "$untils" = *' idle '* ]] && [ -f "$stub/hold-question-grace" ]; then
        touch "$stub/question-grace-entered"
        while [ -f "$stub/hold-question-grace" ]; do sleep 0.05; done
      fi
      started=$SECONDS
      while :; do
        status=idle; [ ! -f "$dir/status" ] || status=$(cat "$dir/status")
        case "$untils" in *" $status "*) agent_reply agent_info; exit ;; esac
        if [ "$timeout" -gt 0 ] && [ "$(( (SECONDS - started) * 1000 ))" -ge "$timeout" ]; then
          error timeout 'timed out waiting for agent status'
        fi
        sleep 0.05
      done
    fi
    # The wrapper must terminate this unbounded server subscription on exit.
    if [ "$5" = blocked ]; then
      trap 'exit 0' TERM INT
      if [ "$#" = 7 ]; then
        test "$6" = --timeout
        sleep 1
        error timeout 'timed out waiting for agent status'
      fi
      while :; do sleep 0.1; done
    fi
    test "$4" = --until; test "$#" = 11; test "${10}" = --timeout
    test "${11}" -gt 0
    if [ -f "$stub/blocked" ]; then error timeout 'timed out waiting for agent status'; fi
    agent_reply agent_info ;;
  'agent get')
    require_agent "$@"
    if [ -f "$stub/goal-mode" ]; then
      count=0; [ ! -f "$dir/goal-checks" ] || count=$(cat "$dir/goal-checks")
      count=$((count + 1)); printf '%s\n' "$count" > "$dir/goal-checks"
      if [ "$count" = 1 ] || [ "$(cat "$stub/goal-mode")" = never-ready ]; then
        error agent_not_found "agent target $3 not found"
      fi
      touch "$dir/goal-ready"
    fi
    agent_reply agent_info ;;
  'pane get')
    pane_json | jq -c '{id:"cli:pane:get",result:{pane:.,type:"pane_info"}}' ;;
  'pane process-info')
    test "$3" = --pane
    if [ -f "$dir/process-info" ]; then cat "$dir/process-info"
    else
      jq -cn --arg pane "$id:p1" '{result:{type:"pane_process_info",process_info:{pane_id:$pane,
        shell_pid:123,foreground_process_group_id:123,foreground_processes:[{pid:123,name:"bash"}]}}}'
    fi ;;
  *) printf 'Unexpected herdr call\n' >&2; exit 1 ;;
esac
