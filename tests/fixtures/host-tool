#!/usr/bin/env bash
set -euo pipefail
name=$(basename "$0")
if [ "$name" = omp ] && [ "${1:-}" = config ]; then
  [ "${3:-}" = compaction.thresholdTokens ] || exit 1
  case "${2:-}" in
    get)
      [ "${4:-}" = --json ] || exit 1
      [ "${HOST_OMP_GET_FAIL:-0}" != 1 ] || exit 1
      value=0
      [ ! -f "$HOME/omp-threshold" ] || value=$(cat "$HOME/omp-threshold")
      printf '{"key":"compaction.thresholdTokens","value":%s,"type":"number"}\n' "$value" ;;
    set)
      [ "${HOST_OMP_SET_FAIL:-0}" != 1 ] || exit 1
      printf '%s\n' "$*" >> "$HOME/omp-writes"
      printf '%s\n' "$4" > "$HOME/omp-threshold" ;;
    *) exit 1 ;;
  esac
  exit
fi
if [ "${1:-}" = auth ] || [ "${1:-}" = login ]; then
  printf '%s\n' 'private auth detail must never be reported'
  [ "$name" != claude ]
  exit
fi
if [ "${1:-}" = models ]; then
  printf '%s\n' 'private auth detail must never be reported'
  # Cursor can claim a login in status while authenticated requests fail.
  [ "$name" != cursor-agent ]
  exit
fi
if [ "${1:-}" = exec ]; then
  printf '%s\n' "$*" >> "$HOME/probes"
  printf '%s\n' 'private provider detail'
  exit "${HOST_PROBE_EXIT:-0}"
fi
if [ "$name" = npm ] && [ "${1:-}" = install ]; then
  printf '%s\n' "$*" >> "$HOME/installs"
  case "${*: -1}" in
    @anthropic-ai/claude-code@*) tool=claude ;;
    pnpm@*) tool=pnpm ;;
    *) exit 1 ;;
  esac
  version=$(printf '%s\n' "${*: -1}" | sed 's/.*@//')
  prefix=''
  while [ "$#" -gt 0 ]; do
    if [ "$1" = --prefix ]; then prefix=$2; break; fi
    shift
  done
  test -n "$prefix"
  rm -f "$prefix/bin/$tool"
  [ "${HOST_NPM_FAIL:-0}" != 1 ] || exit 1
  sed "s/@VER""SION@/$version/" "$HOST_FIXTURES/host-tool" > "$prefix/bin/$tool"
  chmod +x "$prefix/bin/$tool"
  exit
fi
version='@VERSION@'
case "$name" in
  go) printf 'go version go%s linux/amd64\n' "$version" ;;
  node) printf 'v%s\n' "$version" ;;
  *) printf '%s %s\n' "$name" "$version" ;;
esac
