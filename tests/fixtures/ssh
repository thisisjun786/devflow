#!/usr/bin/env bash
set -euo pipefail
if [ "${SSH_POLISH_UNREACHABLE:-0}" != 0 ]; then
  printf '%s\n' "$*" >> "$CASE_DIR/polish-ssh-calls"
  [ "$SSH_POLISH_UNREACHABLE" != hang ] || exec sleep 30
  echo 'Permission denied (publickey)' >&2
  exit 255
fi
if [ "${SSH_BIDDING:-0}" = 1 ]; then
  while [ "$#" -gt 0 ]; do
    case "$1" in -o) shift 2 ;; -*) shift ;; *) break ;; esac
  done
  host=$1; shift
  printf '%s %s\n' "$host" "$*" >> "$CASE_DIR/ssh.calls"
  [ ! -f "$CASE_DIR/hosts/$host/offline" ] || exit 255
  case "$*" in
    'dv bid '*)
      [ ! -f "$CASE_DIR/hosts/$host/hang-bid" ] || exec sleep 10
      if [ -f "$CASE_DIR/hosts/$host/bid.json" ]; then cat "$CASE_DIR/hosts/$host/bid.json"; exit; fi ;;
    'dv _award '*)
      if [ -f "$CASE_DIR/hosts/$host/reject-award" ]; then
        jq -cn '{status:"rejected",reason:"full"}'; exit
      fi
      if [ -f "$CASE_DIR/hosts/$host/drop-award" ]; then
        env DV_CONFIG="$CASE_DIR/hosts/$host/config" bash -c "$*" >/dev/null
        exit 255
      fi ;;
  esac
  exec env DV_CONFIG="$CASE_DIR/hosts/$host/config" bash -c "$*"
fi
if [ -n "${SSH_POLISH_PATH:-}" ]; then
  test "$#" = 8 && test "$1" = -o && test "$2" = BatchMode=yes
  test "$3" = -o && test "$4" = ConnectTimeout=5
  test "$5" = -o && test "$6" = ConnectionAttempts=1 && test "$7" = lina-os
  touch "$CASE_DIR/polish-ssh"
  exec env PATH="$SSH_POLISH_PATH" bash -c "$8"
fi
# Default: a remote `dv status --json`. With SSH_FIXTURE_EXEC=1, run the remote command
# locally as the "remote host", whose DV_HOME is $CASE_DIR/remote-home.
if [ "${SSH_FIXTURE_EXEC:-0}" != 1 ]; then
  case "${*: -1}" in
    "dv status --json") [ ! -f "$CASE_DIR/remote-status-delay" ] || sleep "$(cat "$CASE_DIR/remote-status-delay")" ;;
  esac
  cat "$CASE_DIR/remote-status"; exit
fi
while [ "$#" -gt 0 ]; do
  case "$1" in -o) shift 2 ;; -*) shift ;; *) break ;; esac
done
shift # host
exec env -u DV_HOME DV_CONFIG="$CASE_DIR/remote-home/config.sh" bash -c "$*"
