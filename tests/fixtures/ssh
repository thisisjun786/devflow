#!/usr/bin/env bash
set -euo pipefail
if [ -n "${SSH_POLISH_PATH:-}" ]; then
  test "$#" = 4 && test "$1" = -o && test "$2" = BatchMode=yes && test "$3" = lina-os
  touch "$CASE_DIR/polish-ssh"
  exec env PATH="$SSH_POLISH_PATH" bash -c "$4"
fi
# Default: a remote `dv status --json`. With SSH_FIXTURE_EXEC=1, run the remote command
# locally as the "remote host", whose DV_HOME is $CASE_DIR/remote-home.
if [ "${SSH_FIXTURE_EXEC:-0}" != 1 ]; then cat "$CASE_DIR/remote-status"; exit; fi
while [ "$#" -gt 0 ]; do
  case "$1" in -o) shift 2 ;; -*) shift ;; *) break ;; esac
done
shift # host
exec env -u DV_HOME DV_CONFIG="$CASE_DIR/remote-home/config.sh" bash -c "$*"
