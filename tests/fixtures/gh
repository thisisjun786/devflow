#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >> "$GH_STUB_DIR/calls"
case "$*" in
  'pr create '*) echo https://github.com/test/repo/pull/1 ;;
  'pr checks '*) jq -e 'length>0 and all(.conclusion=="SUCCESS")' "$GH_STUB_DIR/checks" >/dev/null ;;
  'pr view '*)
    head=$(git rev-parse HEAD)
    state=OPEN
    [ ! -f "$GH_STUB_DIR/merged" ] || state=MERGED
    jq -n --arg head "$head" --arg state "$state" --slurpfile checks "$GH_STUB_DIR/checks" --slurpfile reviews "$GH_STUB_DIR/reviews" \
      '{number:1,url:"https://github.com/test/repo/pull/1",state:$state,headRefOid:$head,baseRefName:"main",statusCheckRollup:$checks[0],reviews:$reviews[0]}' ;;
  'pr merge '*) touch "$GH_STUB_DIR/merged" ;;
  *) echo "Unexpected gh call: $*" >&2; exit 1 ;;
esac
