#!/usr/bin/env bash
# Detached PR waiters can inherit a case-specific BASH_ENV as well.
# shellcheck source=tests/process-group.sh
source "$ROOT/tests/process-group.sh"
set -euo pipefail
if [ "${GH_STUB_BODY:-0}" != 1 ]; then printf '%s\n' "$*" >> "$GH_STUB_DIR/calls"; fi
if [ "${1:-}:${2:-}" = api:--include ] && [[ "${3:-}" != */events\?* ]]; then
  endpoint=$3
  body=$(mktemp "$GH_STUB_DIR/.body.XXXXXX")
  trap 'rm -f "$body"' EXIT
  case "$endpoint" in
    */comments\?per_page=100\&page=*|*/reviews\?per_page=100\&page=*)
      GH_STUB_BODY=1 "${GH_STUB_BODY_CMD:-$0}" api --paginate "${endpoint%%\?*}" > "$body"
      page=${endpoint##*&page=}
      jq -s --argjson start "$(((page - 1) * 100))" 'add | .[$start:$start+100]' "$body" > "$body.page"
      mv "$body.page" "$body" ;;
    repos/*/commits/*)
      GH_STUB_BODY=1 "${GH_STUB_BODY_CMD:-$0}" api "$endpoint" --jq .sha | jq -Rn '{sha:input}' > "$body" ;;
    *) GH_STUB_BODY=1 "${GH_STUB_BODY_CMD:-$0}" api "$endpoint" > "$body" ;;
  esac
  etag=$(cksum < "$body" | awk '{print $1 "-" $2}')
  if [ -f "$GH_STUB_DIR/cache-fail" ]; then printf 'HTTP/2.0 503 Unavailable\r\n\r\n'; exit 1; fi
  if [ -f "$GH_STUB_DIR/cache-invalid" ]; then printf 'HTTP/2.0 200 OK\r\nETag: "bad"\r\n\r\n{invalid'; exit; fi
  case "$*" in
    *"If-None-Match: \"$etag\"")
      printf '304\n' >> "$GH_STUB_DIR/cache-status"
      printf 'HTTP/2.0 304 Not Modified\r\n\r\n'; exit "${GH_CACHE_304_EXIT:-0}" ;;
  esac
  printf '200\n' >> "$GH_STUB_DIR/cache-status"
  printf 'HTTP/2.0 200 OK\r\nETag: "%s"\r\n\r\n' "$etag"
  cat "$body"; exit
fi
if [ -f "$GH_STUB_DIR/qa-pr" ]; then
  case "$*" in
    'api --include repos/test/repo/events?per_page=100'*)
      [ ! -f "$GH_STUB_DIR/qa-events-fail" ] || exit 1
      if [ ! -f "$GH_STUB_DIR/qa-events" ]; then printf 'HTTP/2.0 304 Not Modified\r\n\r\n'; exit; fi
      etag=$(cat "$GH_STUB_DIR/qa-etag")
      case "$*" in
        *"If-None-Match: \"$etag\"") printf 'HTTP/2.0 304 Not Modified\r\n\r\n'; exit "${QA_EVENTS_304_EXIT:-0}" ;;
      esac
      printf 'HTTP/2.0 200 OK\r\nETag: "%s"\r\n\r\n' "$etag"
      cat "$GH_STUB_DIR/qa-events"; exit ;;
    'api repos/test/repo/commits/'*' --jq .sha')
      git --git-dir="$CASE_DIR/remote.git" rev-parse "refs/heads/${2##*/}"; exit ;;
    'api repos/test/repo/pulls?'*)
      [ ! -f "$GH_STUB_DIR/qa-api-fail" ] || exit 1
      if [ -f "$GH_STUB_DIR/qa-merges" ]; then jq -s 'sort_by(.merged_at)|reverse' "$GH_STUB_DIR/qa-merges"
      else
        head=$(git --git-dir="$CASE_DIR/remote.git" rev-parse "refs/heads/$(jq -r .base.ref "$GH_STUB_DIR/qa-pr")")
        jq --arg head "$head" '[.+{merge_commit_sha:$head}]' "$GH_STUB_DIR/qa-pr"
      fi
      exit ;;
    'api repos/test/repo/compare/'*)
      if [ -f "$GH_STUB_DIR/qa-diverged" ]; then printf '{"status":"diverged"}\n'
      else printf '{"status":"ahead"}\n'; fi
      exit ;;
    'api repos/test/repo/commits/'*'/pulls')
      count=0
      [ ! -f "$GH_STUB_DIR/qa-pull-count" ] || count=$(cat "$GH_STUB_DIR/qa-pull-count")
      count=$((count + 1)); printf '%s\n' "$count" > "$GH_STUB_DIR/qa-pull-count"
      if [ -f "$GH_STUB_DIR/qa-pull-responses" ]; then
        case "$(sed -n "${count}p" "$GH_STUB_DIR/qa-pull-responses")" in
          fail) printf '{truncated'; printf 'unexpected end of JSON input\n' >&2; exit 1 ;;
          empty) exit 0 ;;
          invalid) printf '{truncated'; exit 0 ;;
        esac
      fi
      if [ -f "$GH_STUB_DIR/qa-empty-pulls" ] && [ "$count" -le "$(cat "$GH_STUB_DIR/qa-empty-pulls")" ]; then
        printf '[]\n'
      else jq -s . "$GH_STUB_DIR/qa-pr"; fi
      exit ;;
    'pr view '*closingIssuesReferences*)
      if [ ! -f "$GH_STUB_DIR/qa-legacy-field" ]; then
        printf 'Unknown JSON field: "closingIssuesReferences"\n' >&2; exit 1
      fi
      jq '{closingIssuesReferences:.data.repository.pullRequest.closingIssuesReferences.nodes}' "$GH_STUB_DIR/qa-graphql"; exit ;;
    'api repos/test/'*'/issues/'*'--jq .milestone // empty')
      jq -c '.data.repository.pullRequest.closingIssuesReferences.nodes[].milestone // empty' "$GH_STUB_DIR/qa-graphql"; exit ;;
    'api graphql '*)
      [ ! -f "$GH_STUB_DIR/qa-graphql-fail" ] || { printf 'GraphQL unavailable\n' >&2; exit 1; }
      [[ "$*" = *'closingIssuesReferences('* ]] && [[ "$*" = *'milestone { number title }'* ]]
      [[ "$*" = *'--paginate'* ]] && [[ "$*" = *'pageInfo'* ]]
      cat "$GH_STUB_DIR/qa-graphql"; exit ;;
    'api --paginate repos/test/repo/issues?state=open&per_page=100') cat "$GH_STUB_DIR/qa-issues"; exit ;;
    'api repos/test/repo/issues?state=open&per_page=100&page='*)
      page=${2##*&page=}
      if [ -f "$GH_STUB_DIR/qa-page-$page" ]; then cat "$GH_STUB_DIR/qa-page-$page"
      elif [ "$page" = 1 ]; then cat "$GH_STUB_DIR/qa-issues"
      else printf '[]\n'; fi
      [ ! -f "$GH_STUB_DIR/qa-page-$page-fail" ] || exit 1
      exit ;;
    'api repos/test/repo/issues/'*)
      number=${2##*/}
      if [ -f "$GH_STUB_DIR/qa-issue-$number" ]; then cat "$GH_STUB_DIR/qa-issue-$number"
      else jq --argjson number "$number" '.[] | select(.number==$number) | .state //= "open"' "$GH_STUB_DIR/qa-issues"; fi
      [ ! -f "$GH_STUB_DIR/qa-issue-$number-fail" ] || exit 1
      exit ;;
    'api --paginate repos/test/'*'/issues/'*'/comments?per_page=100') cat "$GH_STUB_DIR/qa-comments"; exit ;;
    'label create '*) exit ;;
    'issue edit '*) printf 'issue-edit %s\n' "$2" >> "$GH_STUB_DIR/qa-actions"; exit ;;
    'issue comment '*|'pr comment '*)
      target=$3
      action=issue-comment; [ "$1" != pr ] || action=qa-summary
      printf '%s %s\n' "$action" "$target" >> "$GH_STUB_DIR/qa-actions"
      while [ "$1" != --body-file ]; do shift; done
      jq --rawfile body "$2" '.+[{body:$body}]' "$GH_STUB_DIR/qa-comments" > "$GH_STUB_DIR/qa-comments.tmp"
      mv "$GH_STUB_DIR/qa-comments.tmp" "$GH_STUB_DIR/qa-comments"
      exit ;;
    'api --method POST repos/test/repo/issues --input -')
      cat > "$GH_STUB_DIR/qa-created"
      printf 'issue-create\n' >> "$GH_STUB_DIR/qa-actions"
      jq --slurpfile created "$GH_STUB_DIR/qa-created" '.+[$created[0]+{number:20,state:"open"}]' "$GH_STUB_DIR/qa-issues" > "$GH_STUB_DIR/qa-issues.tmp"
      mv "$GH_STUB_DIR/qa-issues.tmp" "$GH_STUB_DIR/qa-issues"
      printf '{"html_url":"https://github.com/test/repo/issues/20"}\n'; exit ;;
    'issue list '*) cat "$GH_STUB_DIR/qa-issues"; exit ;;
  esac
fi
case "$*" in
  'api --method GET --paginate repos/'*'/pulls -f state=open -f head='*)
    [ ! -f "$GH_STUB_DIR/open-prs-fail" ] || exit 1
    if [ -f "$GH_STUB_DIR/open-prs" ]; then cat "$GH_STUB_DIR/open-prs"; else printf '[]\n'; fi ;;
  'api graphql '*closingIssuesReferences*)
    [ ! -f "$GH_STUB_DIR/closing-issues-fail" ] || { printf 'GraphQL unavailable\n' >&2; exit 1; }
    [[ "$*" = *'--paginate'* ]] && [[ "$*" = *'pageInfo'* ]]
    if [ -f "$GH_STUB_DIR/closing-issues" ]; then cat "$GH_STUB_DIR/closing-issues"
    else printf '{"data":{"repository":{"pullRequest":{"closingIssuesReferences":{"nodes":[]}}}}}\n'; fi ;;
  'api --paginate repos/'*/issues/*/comments)
    [ ! -f "$GH_STUB_DIR/issue-comments-fail" ] || exit 1
    number=${3%/comments}; number=${number##*/}
    if [ -f "$GH_STUB_DIR/issue-$number-comments" ]; then cat "$GH_STUB_DIR/issue-$number-comments"
    elif [ -f "$GH_STUB_DIR/issue-comments" ]; then cat "$GH_STUB_DIR/issue-comments"; else printf '[]\n'; fi ;;
  'api --method POST repos/'*'/issues/'*'/comments -F body=@'*)
    [ "$#" = 6 ] || { echo "Unexpected gh call: $*" >&2; exit 1; }
    number=${4%/comments}; number=${number##*/}
    file="$GH_STUB_DIR/issue-$number-comments"
    [ -f "$file" ] || printf '[]\n' > "$file"
    jq --rawfile body "${6#body=@}" '.+[{id:(length+1),body:$body}]' "$file" > "$file.tmp"
    mv "$file.tmp" "$file"
    jq -n --arg number "$number" '{html_url:("https://github.com/test/repo/issues/"+$number+"#issuecomment-1")}' ;;
  'api --paginate repos/'*/reviews)
    [ ! -f "$GH_STUB_DIR/reviews-fail" ] || exit 1
    head=$(git rev-parse HEAD)
    [ ! -f "$GH_STUB_DIR/head" ] || head=$(cat "$GH_STUB_DIR/head")
    jq --arg head "$head" 'if .=="auto" then [{id:1,user:{login:"chatgpt-codex-connector[bot]"},commit_id:$head,state:"COMMENTED",submitted_at:"2026-10-22T01:00:00Z",body:"Looks good"}]
      else to_entries | map(.key as $i | .value | .user //= .author | .commit_id //= .commit.oid | .id //= ($i+1) | .state //= "COMMENTED" | .submitted_at //= "2026-10-22T01:00:00Z") end' "$GH_STUB_DIR/reviews" ;;
  'pr comment '* )
    if [ -f "$GH_STUB_DIR/review-on-request" ]; then
      jq --arg head "$(git rev-parse HEAD)" '[.[-1] | .id+=1 | .commit_id=$head | .body="Looks good"]' "$GH_STUB_DIR/reviews" > "$GH_STUB_DIR/reviews.tmp"
      mv "$GH_STUB_DIR/reviews.tmp" "$GH_STUB_DIR/reviews"
      printf '[]\n' > "$GH_STUB_DIR/comments"
    fi ;;
  'api --paginate repos/'*'/issues?state=all&per_page=100')
    if [ -f "$GH_STUB_DIR/followups" ]; then cat "$GH_STUB_DIR/followups"; else printf '[]\n'; fi ;;
  'api repos/'*'/issues/'*' --jq .milestone.number // null')
    # gh --jq renders JSON null as empty output, unlike standalone jq.
    if [ -f "$GH_STUB_DIR/no-milestone" ]; then printf '\n'
    elif [ -f "$GH_STUB_DIR/source-milestones" ]; then
      jq -r --arg number "${2##*/}" '.[$number] // empty' "$GH_STUB_DIR/source-milestones"
    else printf '7\n'; fi ;;
  'api --method POST repos/'*'/issues --input '*|'api --method PATCH repos/'*'/issues/'*' --input '*)
    jq '.+{number:20,html_url:"https://github.com/test/repo/issues/20"}' "$6" > "$GH_STUB_DIR/followup"
    jq -s '.' "$GH_STUB_DIR/followup" > "$GH_STUB_DIR/followups"
    cat "$GH_STUB_DIR/followup" ;;
  'api repos/'*'/pulls/'*' --jq .body // ""')
    if [ -f "$GH_STUB_DIR/live-body" ]; then cat "$GH_STUB_DIR/live-body"; fi ;;
  'api --paginate repos/'*/comments)
    [ ! -f "$GH_STUB_DIR/comments-fail" ] || exit 1
    if [ -f "$GH_STUB_DIR/comments" ]; then cat "$GH_STUB_DIR/comments"; else printf '[]\n'; fi ;;
  'repo view --json mergeCommitAllowed,squashMergeAllowed,rebaseMergeAllowed')
    [ ! -f "$GH_STUB_DIR/repo-fail" ] || exit 1
    if [ "${GH_REPO:-}" = other/repo ]; then
      printf '{"mergeCommitAllowed":true,"squashMergeAllowed":false,"rebaseMergeAllowed":false}\n'
    elif [ -f "$GH_STUB_DIR/repo-methods" ]; then cat "$GH_STUB_DIR/repo-methods"
    else printf '{"mergeCommitAllowed":true,"squashMergeAllowed":true,"rebaseMergeAllowed":true}\n'; fi ;;
  'pr create '*)
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --body-file) cp "$2" "$GH_STUB_DIR/live-body"; shift 2 ;;
        --title) printf '%s\n' "$2" > "$GH_STUB_DIR/live-title"; shift 2 ;;
        *) shift ;;
      esac
    done
    echo https://github.com/test/repo/pull/1 ;;
  'pr edit '*)
    [ ! -f "$GH_STUB_DIR/projectcards-error" ] || { echo 'GraphQL: deprecated projectCards' >&2; exit 1; }
    [ ! -f "$GH_STUB_DIR/edit-fail" ] || exit 1
    test "$4" = --body-file
    cp "$5" "$GH_STUB_DIR/live-body" ;;
  'api --method PATCH repos/'*|'api -X PATCH repos/'*)
    [ ! -f "$GH_STUB_DIR/edit-fail" ] || exit 1
    test "$4" = "${GH_STUB_PR_ENDPOINT:-repos/test/repo/pulls/1}"
    shift 4
    while [ "$#" -gt 0 ]; do
      case "$1:$2" in
        -F:body=@*)
          cp "${2#body=@}" "$GH_STUB_DIR/edited-body"
          cp "${2#body=@}" "$GH_STUB_DIR/live-body" ;;
        -f:title=*) printf '%s\n' "${2#title=}" > "$GH_STUB_DIR/live-title" ;;
        *) echo "Unexpected PATCH field: $*" >&2; exit 1 ;;
      esac
      shift 2
    done ;;
  'api repos/'*'/issues/'[1-9]*)
    # Prerequisite lookups read one issue fixture each.
    number=${2##*/}
    if [ "$#" != 2 ] || [ ! -f "$GH_STUB_DIR/issue-$number.json" ]; then echo "Unexpected gh call: $*" >&2; exit 1; fi
    cat "$GH_STUB_DIR/issue-$number.json" ;;
  'api repos/'*)
    if [ "$#" = 2 ] && [ "$2" = "repos/${GH_STUB_LAND_REPO:-test/repo}" ]; then
      [ ! -f "$GH_STUB_DIR/repo-fail" ] || exit 1
      if [ -f "$GH_STUB_DIR/repo-methods" ]; then
        jq '{allow_merge_commit:.mergeCommitAllowed,allow_squash_merge:.squashMergeAllowed,allow_rebase_merge:.rebaseMergeAllowed}' "$GH_STUB_DIR/repo-methods"
      else printf '{"allow_merge_commit":true,"allow_squash_merge":true,"allow_rebase_merge":true}\n'; fi
      exit
    fi
    [ ! -f "$GH_STUB_DIR/read-fail" ] || exit 1
    test "$#" = 2 && test "$2" = "${GH_STUB_PR_ENDPOINT:-repos/test/repo/pulls/1}"
    jq -n --rawfile body "$GH_STUB_DIR/live-body" '{body:$body}' ;;
  'pr checks '*) jq -e 'length>0 and all(.conclusion=="SUCCESS")' "$GH_STUB_DIR/checks" >/dev/null ;;
  'pr view '*)
    touch "$GH_STUB_DIR/viewed"
    head=$(git rev-parse HEAD)
    [ ! -f "$GH_STUB_DIR/head" ] || head=$(cat "$GH_STUB_DIR/head")
    state=OPEN
    [ ! -f "$GH_STUB_DIR/merged" ] || state=MERGED
    [ ! -f "$GH_STUB_DIR/merge-unconfirmed" ] || state=OPEN
    [ ! -f "$GH_STUB_DIR/head-mismatch" ] || head=wrong-head
    body=''; [ ! -f "$GH_STUB_DIR/live-body" ] || body=$(cat "$GH_STUB_DIR/live-body")
    merged_at=''; [ ! -f "$GH_STUB_DIR/merged-at" ] || merged_at=$(cat "$GH_STUB_DIR/merged-at")
    # Optional per-PR maps keyed by number: pr-states, pr-bases, merge-commits.
    number=${3##*/}; base=main; merge_commit=''
    if [ -f "$GH_STUB_DIR/pr-states" ]; then
      value=$(jq -r --arg n "$number" '.[$n] // empty' "$GH_STUB_DIR/pr-states"); [ -z "$value" ] || state=$value
    fi
    if [ -f "$GH_STUB_DIR/pr-bases" ]; then
      value=$(jq -r --arg n "$number" '.[$n] // empty' "$GH_STUB_DIR/pr-bases"); [ -z "$value" ] || base=$value
    fi
    [ ! -f "$GH_STUB_DIR/merge-commits" ] || merge_commit=$(jq -r --arg n "$number" '.[$n] // empty' "$GH_STUB_DIR/merge-commits")
    mergeable=MERGEABLE; [ ! -f "$GH_STUB_DIR/mergeable" ] || mergeable=$(cat "$GH_STUB_DIR/mergeable")
    jq -n --arg body "$body" --arg head "$head" --arg state "$state" --arg merged_at "$merged_at" --arg base "$base" --arg merge_commit "$merge_commit" --arg mergeable "$mergeable" \
      --slurpfile checks "$GH_STUB_DIR/checks" --slurpfile reviews "$GH_STUB_DIR/reviews" \
      '{body:$body,number:1,url:"https://github.com/test/repo/pull/1",state:$state,headRefOid:$head,mergedAt:(if $merged_at=="" then null else $merged_at end),baseRefName:$base,
        mergeCommit:(if $merge_commit=="" then null else {oid:$merge_commit} end),mergeable:$mergeable,statusCheckRollup:$checks[0],reviews:$reviews[0]}' ;;
  'pr merge '*) touch "$GH_STUB_DIR/merged" ;;
  *) echo "Unexpected gh call: $*" >&2; exit 1 ;;
esac
