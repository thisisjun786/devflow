#!/usr/bin/env bash
set -euo pipefail
state="$DV_STATE/$DV_ISSUE"
printf '%s\n' "$@" | jq -R . | jq -s . > "$state/args.json"
agent=$(jq -r .agent "$state/meta")
wait_path() {
  for _ in {1..100}; do [ ! -f "$1" ] || return 0; sleep 0.05; done
  return 1
}
if [ "$agent" = devin ]; then
  printf 'Do you trust this folder?\n'
  wait_path "$state/trust-enter"
elif [ "$agent" = codex ] && [[ " $* " != *' exec '* ]]; then
  if [ -f "$CASE_DIR/herdr/w-$DV_ISSUE/startup-mode" ]; then
    mode=$(cat "$CASE_DIR/herdr/w-$DV_ISSUE/startup-mode")
    printf 'dv-ready>\n'
    for _ in {1..200}; do
      if [ -s "$state/events.log" ] && jq -se 'any(.[]; .kind=="failed")' "$state/events.log" >/dev/null; then exit 0; fi
      if [ -f "$state/goal-input" ]; then
        if [ "$mode" = screen-working ]; then break; fi
        if [ "$mode" = enter ] && [ -f "$CASE_DIR/herdr/w-$DV_ISSUE/retry-enter" ]; then break; fi
      fi
      sleep 0.05
    done
    case "$mode" in enter|screen-working) ;; *) exit 1 ;; esac
  elif [ -f "$CASE_DIR/herdr/goal-mode" ]; then
    printf 'old shell › ❯\nCodex starting...\n'
    for _ in {1..200}; do
      [ ! -f "$state/goal-input" ] || break
      if [ -f "$state/events.log" ] && jq -se 'any(.[]; .kind=="failed")' "$state/events.log" >/dev/null; then exit 0; fi
      sleep 0.05
    done
    test -f "$state/goal-input"
  else
    printf 'dv-ready>\n'
    wait_path "$state/goal-input"
  fi
fi
if [ -f "$CASE_DIR/herdr/question-mode" ]; then
  printf '%s\n' "$PPID" > "$state/wrapper.pid"
  printf '%s\n' "$$" > "$state/held.pid"
  while [ ! -f "$state/release" ]; do sleep 0.05; done
fi
printf 'native output before done\n'
"$ROOT/tests/fixtures/agent"
printf 'native output after done\n'
