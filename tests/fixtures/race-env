#!/usr/bin/env bash
# Sourced only by the lock regression cases through BASH_ENV.
# Use env to bypass these functions: Bash 3.2's command builtin can trigger
# errexit even when the caller handles the external command's failure.
sleep() {
  # Exercise all lock retries without adding ten seconds to the suite.
  if [ "${DV_TEST_RACE:-}" = timeout ] && [ "$*" = 0.1 ]; then return 0; fi
  env sleep "$@"
}
mkdir() {
  if [ "${DV_TEST_RACE:-}" = admission ] && [ "$*" = "$DV_STATE/.admission-lock" ]; then
    # uutils 0.8.0 can report success to both concurrent mkdir callers.
    env mkdir "$@" 2>/dev/null || true
    touch "$CASE_DIR/attempt-$DV_TEST_ACTOR"
    return 0
  fi
  env mkdir "$@"
}
ln() {
  local rc=0
  env ln "$@" || rc=$?
  if [ "$rc" != 0 ]; then touch "$CASE_DIR/contended-$DV_TEST_ACTOR"; fi
  return "$rc"
}
rmdir() {
  if [ "${DV_TEST_RACE:-}" = admission ] && [ "$*" = "$DV_STATE/.admission-lock" ]; then
    printf '%s %s\n' "$DV_TEST_ACTOR" "$$" >> "$CASE_DIR/removers"
  fi
  env rmdir "$@"
}
git() {
  if [ "${DV_TEST_RACE:-}" = worktree ] && [ "${3:-} ${4:-}" = 'worktree add' ]; then
    touch "$CASE_DIR/entered-$DV_TEST_ACTOR"
    if [ "$DV_TEST_ACTOR" = 1 ]; then
      local tries=0
      until [ -f "$CASE_DIR/release" ]; do
        tries=$((tries+1)); [ "$tries" -lt 200 ] || return 1
        sleep 0.05
      done
    elif [ ! -f "$CASE_DIR/release" ]; then
      echo 'overlapping git worktree add' >&2
      return 1
    fi
  fi
  env git "$@"
}
