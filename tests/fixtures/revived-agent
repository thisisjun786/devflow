#!/usr/bin/env bash
set -euo pipefail
state="$DV_STATE/$DV_ISSUE"
wait_start_file() {
  local deadline=$((SECONDS + DV_START_WAIT))
  while [ ! -f "$1" ]; do
    [ "$SECONDS" -lt "$deadline" ] || return 1
    sleep 0.05
  done
}
agent_mode=$(jq -r '.agent+":"+.mode' "$state/meta")
if [ "$agent_mode" = codex:goal ]; then
  printf 'dv-ready>\n'
  wait_start_file "$state/goal-input"
  printf 'Pursuing goal\n'
elif [[ "$agent_mode" = devin:* ]]; then
  # The fake herdr records Enter in the same place as initial Devin startup.
  printf 'Do you trust this folder?\n'
  wait_start_file "$state/trust-enter"
fi
# A terminal may enter through the physical path even if metadata kept an alias.
jq -n --arg cwd "$(pwd -P)" --args '{cwd:$cwd,args:$ARGS.positional}' -- "$@" > "$state/revived-input.json"
printf 'started\n' >> "$state/revived-runs"
trap 'rm -f "$CASE_DIR/herdr/w-$DV_ISSUE/detected"' EXIT
if [ "${DV_REVIVE_TEST_HOLD:-0}" = 1 ]; then
  printf "%s\n" "$$" > "$state/held.pid"
  while [ ! -f "$state/revive-release" ]; do sleep 0.05; done
fi
if [ "${DV_REVIVE_TEST_FAIL:-0}" = 1 ]; then exit 1; fi
if [ "${DV_REVIVE_TEST_NO_DONE:-0}" = 1 ]; then exit 0; fi
if [ "${DV_REVIVE_TEST_REPORT:-0}" = 1 ]; then printf 'Corrected report\n' > "$state/report.md"; fi
dv 'done' "$DV_ISSUE"
if [ "${DV_REVIVE_TEST_HOLD_DONE:-0}" = 1 ]; then
  touch "$state/revive-done-held"
  while [ ! -f "$state/revive-exit-release" ]; do sleep 0.05; done
fi
