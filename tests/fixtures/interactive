#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$@" | jq -R . | jq -s . > "$DV_STATE/$DV_ISSUE/args.json"
agent=$(jq -r .agent "$DV_STATE/$DV_ISSUE/meta")
if [ "$agent" = omp ]; then printf '%s\n' "${OMP_SKIP_SETUP:-}" > "$DV_STATE/$DV_ISSUE/omp-skip-setup"; fi
if [ "$agent" = devin ] || [ "$agent" = agy ] || [ "$agent" = grok ]; then
  printf 'Do you trust this folder?\n'
  IFS= read -r line
  printf '%s\n' "$line" > "$DV_STATE/$DV_ISSUE/trust-enter"
elif [[ " $* " != *' exec '* ]] && [ "$(jq -r .agent "$DV_STATE/$DV_ISSUE/meta")" = codex ]; then
  if [ -f "$CASE_DIR/codex-startup-mode" ] && [ "$(cat "$CASE_DIR/codex-startup-mode")" = hook ]; then
    printf '1 hook needs review\nt trust all · enter review\n'
  fi
  if [ -f "$CASE_DIR/codex-startup-mode" ] && [ "$(cat "$CASE_DIR/codex-startup-mode")" = folder ]; then
    printf 'Folder access\nTrust this folder?\n› 1. Trust and continue\n'
  fi
  printf 'dv-ready> '
  IFS= read -r line
  printf '%s\n' "$line" > "$DV_STATE/$DV_ISSUE/goal-input"
  if [ -f "$CASE_DIR/codex-startup-mode" ]; then
    printf '\n› \n'
    IFS= read -r line
    printf '%s\n' "$line" > "$DV_STATE/$DV_ISSUE/unexpected-input"
    exit 1
  fi
  printf 'Pursuing goal\n'
fi
"$ROOT/tests/fixtures/agent"
if [[ " $* " = *' exec '* ]]; then exit; fi
printf 'dv-ready> '
while IFS= read -r line; do printf '%s\n' "$line" >> "$DV_STATE/$DV_ISSUE/sent-input"; done
